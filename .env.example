# Copy this file to .env and fill in real values before deploying.
# docker compose automatically reads a .env file in this directory.

# ---- Database ----
DB_NAME=jyoti_sales
DB_USER=jyoti
DB_PASSWORD=jyoti_pass

# ---- Backend / JWT ----
JWT_SECRET=change-this-super-secret-key-min-32-chars-long-please
CORS_ORIGINS=http://localhost:5173

# ---- Payment gateway ----
# Set PAYMENT_PROVIDER=razorpay and fill in your keys below to use real Razorpay payments.
# Get keys from: https://dashboard.razorpay.com/app/keys
# Test keys start with rzp_test_ | Live keys start with rzp_live_
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
# Set in Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# For COD only / demo mode without real payments, set:
# PAYMENT_PROVIDER=dummy

# ---- Email (SMTP) ----
# Works with Gmail App Password (https://myaccount.google.com/apppasswords),
# Zoho Mail, AWS SES, or any SMTP provider.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youremail@gmail.com
MAIL_PASSWORD=your_app_password

# ---- Frontend / App ----
FRONTEND_URL=https://jyotisales.in

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080/api

# ---- Firebase (Frontend — from Firebase Console > Project Settings > Your Apps) ----
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ---- Firebase (Backend — path to service account JSON) ----
# Download from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Place the file in jyoti-sales-backend/src/main/resources/ or provide an absolute path
FIREBASE_SERVICE_ACCOUNT=classpath:firebase-service-account.json

# ---- Business details (Section 1 placeholders) ----
BIZ_NAME=Jyoti Sales
BIZ_ADDRESS=[[Full shop address, PIN]]
BIZ_PHONE=[[10-digit number]]
BIZ_EMAIL=[[email]]
BIZ_GSTIN=[[GSTIN]]
