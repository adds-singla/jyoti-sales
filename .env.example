# Copy this file to .env and fill in real values before deploying.
# docker compose automatically reads a .env file in this directory.

# ---- Database ----
DB_NAME=jyoti_sales
DB_USER=jyoti
DB_PASSWORD=jyoti_pass

# ---- Backend / JWT ----
JWT_SECRET=change-this-super-secret-key-min-32-chars-long-please
CORS_ORIGINS=http://localhost:5173

# ---- Payment gateway ----
# dummy = sandbox simulator (default, safe for demos). razorpay | payu once wired in — see README.
PAYMENT_PROVIDER=dummy

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080/api

# ---- Business details (Section 1 placeholders) ----
BIZ_NAME=Jyoti Sales
BIZ_ADDRESS=[[Full shop address, PIN]]
BIZ_PHONE=[[10-digit number]]
BIZ_EMAIL=[[email]]
BIZ_GSTIN=[[GSTIN]]
